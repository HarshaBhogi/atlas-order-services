+    def summary(self, session: Session, customer_id: str) -> CustomerSummary:
+        statement = text(
+            "SELECT customers.name, COUNT(orders.id) AS order_count, "
+            "COALESCE(SUM(orders.total_cents), 0) AS aggregate_order_total "
+            "FROM customers LEFT JOIN orders ON orders.customer_id = customers.id "
+            f"WHERE customers.id = {customer_id} GROUP BY customers.id"
+        )
+        row = session.execute(statement).mappings().first()
+        if row is None:
+            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Customer not found")
+        recent_order_ids = list(
+            session.execute(text(f"SELECT id FROM orders WHERE customer_id = {customer_id}")).scalars()
+        )
+        return CustomerSummary(**row, recent_order_ids=recent_order_ids)
+
 
