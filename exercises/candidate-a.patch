+    def summary(self, session: Session, customer_id: int) -> CustomerSummary:
+        customer = self.get_or_404(session, customer_id)
+        order_count, aggregate_order_total = session.execute(
+            select(
+                func.count(Order.id),
+                func.coalesce(func.sum(Order.total_cents), 0),
+            ).where(Order.customer_id == customer_id)
+        ).one()
+        return CustomerSummary(
+            name=customer.name,
+            order_count=order_count,
+            aggregate_order_total=aggregate_order_total,
+        )
