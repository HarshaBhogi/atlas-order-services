diff --git a/tests/test_customer_summary.py b/tests/test_customer_summary.py
new file mode 100644
--- /dev/null
+++ b/tests/test_customer_summary.py
@@ -0,0 +1,20 @@
+from fastapi.testclient import TestClient
+
+
+def test_customer_summary_returns_order_totals(
+    client: TestClient, operator_headers: dict[str, str]
+) -> None:
+    response = client.get("/api/v1/customers/1/summary", headers=operator_headers)
+    assert response.status_code == 200
+    assert response.json() == {
+        "name": "Nova Mart",
+        "order_count": 1,
+        "aggregate_order_total": 23800,
+    }
+
+
+def test_customer_summary_returns_not_found_for_unknown_customer(
+    client: TestClient, operator_headers: dict[str, str]
+) -> None:
+    response = client.get("/api/v1/customers/9999/summary", headers=operator_headers)
+    assert response.status_code == 404
